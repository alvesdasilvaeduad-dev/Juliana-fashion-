document.querySelectorAll('.stars[data-r]').forEach(function(s){var u='<svg style="width:24px;height:24px;margin-right:3px"><use href="#star"/></svg>',x='';for(var k=0;k<5;k++)x+='<i class="i">'+u+'</i>';s.innerHTML='<span class="b">'+x+'</span><span class="f" style="--w:'+s.dataset.r+'%">'+x+'</span>'});
var io='IntersectionObserver'in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15}):null;
document.querySelectorAll('.rv').forEach(function(e){io?io.observe(e):e.classList.add('in')});
function meta(n,v){var m=document.querySelector('meta[name="'+n+'"]');if(m)m.setAttribute('content',v)}
function route(){
var p=(location.hash||'#/').slice(1).split('?')[0],s=null;
if(!R[p]&&p.charAt(0)!=='/'){s=p;p='/'}
var r=R[p]||['Página não encontrada (404) | Juliana Fashion','A página que você procura não existe. Volte ao site da Juliana Fashion.','e404',0];
document.querySelectorAll('.pg').forEach(function(e){e.classList.toggle('on',e.id===r[2])});
document.title=r[0];meta('description',r[1]);meta('robots',r[3]?'index,follow':'noindex,follow');
document.getElementById('crumbs').innerHTML=r[2]==='home'?'':'<a href="#/">Início</a> › '+(N[p]||'Página não encontrada');
if(s){var t=document.getElementById(s);if(t)t.scrollIntoView()}else window.scrollTo(0,0);
gtag('event','page_view',{page_title:r[0],page_path:p});
}
document.querySelectorAll('nav a[data-s]').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();if(location.hash&&location.hash!=='#/')location.hash='#/';setTimeout(function(){document.getElementById(a.dataset.s).scrollIntoView()},30)})});
addEventListener('hashchange',route);route();
document.getElementById('f').addEventListener('submit',function(e){e.preventDefault();gtag('event','generate_lead');location.hash='#/obrigado'});
var D=['domingo','segunda-feira','terça-feira','quarta-feira','quinta-feira','sexta-feira','sábado'];
var f=new Intl.DateTimeFormat('en-US',{timeZone:'America/Sao_Paulo',weekday:'short',hour:'numeric',minute:'numeric',hour12:false}).formatToParts(new Date()),o={};
f.forEach(function(x){o[x.type]=x.value});
var d=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(o.weekday),m=(+o.hour%24)*60+ +o.minute,h='';
D.forEach(function(x,i){h+='<tr'+(i===d?' class="today"':'')+'><td>'+x+'</td><td>'+(i===0?'Fechado':'08:00–20:00')+'</td></tr>'});
document.getElementById('hrs').innerHTML=h;
var st=document.getElementById('status'),tx=document.getElementById('stt');
if(d>0&&m>=480&&m<1200){st.className='open';tx.textContent='Aberto · fecha às 20:00'}
else{st.className='closed';tx.textContent=(d>0&&m<480)||(d===6&&m<480)?'Fechado · abre às 08:00':(d===6&&m>=1200)?'Fechado · abre segunda às 08:00':'Fechado · abre amanhã às 08:00'}
</script>
